import heapq

def prim(graph, start=0):
    visited = set()
    min_heap = [(0, start)]  # (weight, vertex)
    mst = []
    total_cost = 0

    while min_heap:
        weight, u = heapq.heappop(min_heap)

        if u in visited:
            continue

        visited.add(u)
        total_cost += weight

        if weight != 0:
            mst.append((u, weight))

        for v, w in graph[u]:
            if v not in visited:
                heapq.heappush(min_heap, (w, v))

    return total_cost, mst


# Graph represented as an adjacency list
graph = {
    0: [(1, 2), (3, 6)],
    1: [(0, 2), (2, 3), (3, 8), (4, 5)],
    2: [(1, 3), (4, 7)],
    3: [(0, 6), (1, 8), (4, 9)],
    4: [(1, 5), (2, 7), (3, 9)]
}

cost, mst = prim(graph)

print("Minimum Cost:", cost)
print("MST edges:", mst)
